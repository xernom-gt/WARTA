{
  "name": "warta",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --filter admin dev",
    "dev:admin": "pnpm --filter admin dev",
    "dev:landing": "pnpm --filter landing dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "preview": "pnpm -r preview",
    "codegen": "openapi-typescript docs/api/openapi.yaml -o admin/src/types/api.ts && openapi-typescript docs/api/openapi.yaml -o landing/src/types/api.ts",
    "generate:types": "pnpm codegen"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
