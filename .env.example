# Copy to .env (or export the values) before running the API.
# DATABASE_URL / POSTGRES_* must match docker-compose.yml's db service.

# HTTP port the API listens on
API_PORT=3000

# PostgreSQL connection string (pgx format). The compose db publishes
# localhost:5433 (see docker-compose.yml); change if you run your own server.
DATABASE_URL=postgres://warta:warta@localhost:5433/warta?sslmode=disable

# HS256 signing secret for JWT access tokens.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me

# Access token lifetime in seconds (api-requirements §3.1: 3600)
JWT_TTL_SECONDS=3600

# Abuse limits (§13.4): login per minute/IP, register per hour/IP
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5

# resend-verification per account per hour (api-requirements §6.21: 3)
RESEND_RATE_LIMIT=3

# --- Object Storage (S3 / MinIO / Cloudflare R2) (§11.1) -----------------------
# Set STORAGE_DRIVER=s3 to store media binaries in S3/MinIO. Leave empty or
# STORAGE_DRIVER=memory to use the in-memory object store for local development.
STORAGE_DRIVER=memory
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=warta-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://storage.warta.id
S3_FORCE_PATH_STYLE=1

# --- Outgoing email (api-requirements §3.5) -----------------------------------
# Leave SMTP_HOST empty to run without a mail server: every verification mail
# is then printed to the API log (console transport) including its verify
# link. Set a host to deliver over SMTP (implicit TLS on port 465, STARTTLS
# otherwise; credentials optional and only sent if advertised).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# RFC 5322 From header of transactional mail
MAIL_FROM=WARTA <no-reply@warta.id>

# Frontend page that consumes the emailed token; the link is
# MAIL_VERIFY_BASE_URL followed by ?token=<single-use token>
MAIL_VERIFY_BASE_URL=http://localhost:5173/verify-email

# Set to 1 to insert three development citizens when the users table is
# empty (dev only: password warta-dev-2026; see api/server.go devSeedUsers)
WARTA_SEED=1
