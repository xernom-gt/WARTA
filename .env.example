# Copy to .env (or export the values) before running the API.
# DATABASE_URL / POSTGRES_* must match docker-compose.yml's db service.

# HTTP port the API listens on
API_PORT=3000

# PostgreSQL connection string (pgx format). The compose db publishes
# localhost:5433 (see docker-compose.yml); change if you run your own server.
DATABASE_URL=postgres://warta:warta@localhost:5433/warta?sslmode=disable

# HS256 signing secret for JWT access tokens.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me

# Access token lifetime in seconds (api-requirements §3.1: 3600)
JWT_TTL_SECONDS=3600

# Abuse limits (§13.4): login per minute/IP, register per hour/IP
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=5

# Set to 1 to insert three development citizens when the users table is
# empty (dev only: password warta-dev-2026; see api/server.go devSeedUsers)
WARTA_SEED=1
